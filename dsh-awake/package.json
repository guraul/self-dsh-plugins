{
  "name": "dsh-plugin-awake",
  "version": "0.1.0",
  "description": "Keep-awake toggle for the DeepSeek Harness Web UI: one coffee-cup button in the composer starts a host-side `caffeinate -i` assertion, a second click stops it; the icon colour reports the active state.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "node scripts/lint.js",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guraul/self-dsh-plugins.git",
    "directory": "dsh-awake"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "caffeinate",
    "keep-awake"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
