{
  "name": "dsh-plugin-auto-upgrade",
  "version": "0.2.5",
  "description": "Self-upgrade for the DeepSeek Harness Web UI: detect a new dsh release and installed-plugin compatibility on the day's first page load, notify in a non-blocking overlay, then back up, install, verify and restart on one explicit click.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guraul/self-dsh-plugins.git",
    "directory": "dsh-auto-upgrade"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "self-update",
    "upgrade"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
