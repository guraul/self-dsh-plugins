{
  "name": "@mhfire/dsh-im-bridge",
  "version": "0.5.0-ws.1",
  "description": "企业微信智能机器人 ⇄ DeepSeek Harness Agent 桥接插件（本地 fork：新增 /ws 工作区列表与切换）：进程内按企微窗口创建 Agent（单聊一人一条、同一群共用一条），会话在 GUI 实时可见；含 Settings 插件配置卡片",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MHfire/dsh-im-bridge.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "tsdown.host.ts",
    "tsdown.client.ts",
    "tsconfig.json",
    "cordis.patch.yml",
    "persona.default.md",
    "persona.default.en.md",
    "persona.example.md",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsdown --config tsdown.host.ts",
    "build:client": "tsdown --config tsdown.client.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "^0.2.1-rc.2 || ^0.2.1-rc.4",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.4": "compatible",
        "0.2.2-alpha.2": "incompatible"
      },
      "dshDepth": {
        "0.2.1-rc.2": "L2",
        "0.2.1-rc.4": "L2",
        "0.2.2-alpha.2": "L3"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-session-title": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2 || ^0.2.1-rc.4",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7",
    "@wecom/cli": "^1.2.0",
    "fflate": "^0.8.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
